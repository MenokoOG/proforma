{
  "name": "proforma",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Build the AI business case. A mobile-first tool that turns a Gen AI initiative into a five-year cost, benefit and risk projection with payback, ROI, NPV, IRR and peak funding need.",
  "keywords": [
    "business-case",
    "roi",
    "npv",
    "irr",
    "payback-period",
    "financial-model",
    "ai-strategy",
    "generative-ai",
    "token-cost-calculator",
    "cost-benefit-analysis",
    "react",
    "typescript",
    "vite",
    "offline-first",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MenokoOG/proforma.git"
  },
  "bugs": {
    "url": "https://github.com/MenokoOG/proforma/issues"
  },
  "license": "Apache-2.0",
  "author": "classHuman AI LLC",
  "contributors": [
    "Lawrence Jefferson II <https://github.com/MenokoOG>"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assist": "node server/index.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.11",
    "vitest": "^3.2.7"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.68.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
