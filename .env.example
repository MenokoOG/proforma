# ProForma — optional AI review server
#
# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
# The application itself needs none of this: it runs entirely in the browser
# with no backend. This file only configures `npm run assist`.
#
# Read SECURITY.md before running the assist server. It is unauthenticated
# and binds to loopback on purpose. Do not put it on the public internet.

# Your Anthropic API key. Stays in the assist server process and is never
# sent to the browser.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used for the review. Optional; defaults to claude-opus-5.
PROFORMA_MODEL=claude-opus-5

# Port for the assist server. Optional; defaults to 8787, which is what the
# Vite dev proxy expects.
PORT=8787
